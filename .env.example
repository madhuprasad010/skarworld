# ============================================================
# SKARWORLD REVENUE OS — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_ENV=development

# --- Backend ---
APP_ENV=development
SECRET_KEY=change-me-to-a-random-secret-key
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/skarworld
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173

# --- JWT ---
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-api-your-key-here

# --- WhatsApp Business Cloud API ---
WHATSAPP_API_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# --- Amazon SES ---
AWS_SES_ACCESS_KEY_ID=your-ses-access-key
AWS_SES_SECRET_ACCESS_KEY=your-ses-secret-key
AWS_SES_REGION=us-east-1
SES_SENDER_EMAIL=noreply@yourdomain.com

# --- Telegram ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_SECRET=your-telegram-webhook-secret

# --- Research APIs ---
TAVILY_API_KEY=your-tavily-api-key
BRAVE_SEARCH_API_KEY=your-brave-search-api-key

# --- File Storage (optional) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# --- Payment Providers (optional) ---
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
